<?xml version="1.0" encoding="utf-8"?>
<!--
  bcdevenv is a standalone .NET 10 tool that depends on public NuGet packages
  (Microsoft.PowerShell.SDK, Microsoft.Data.SqlClient) which are not in the
  enlistment's internal DynamicsSMBPackages feed. <clear /> drops the inherited
  internal-only source so the tool restores from nuget.org.

  Behind the corporate firewall, restore instead from the internal feed (it
  mirrors these packages) by replacing the source below, or run the restore from
  a machine with nuget.org access.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- A user/machine-level config may disable nuget.org globally; clear that
       inherited state so this repo always restores from the source above. -->
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
